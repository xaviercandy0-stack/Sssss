--=========================================================
local bv, bvVel = nil, Vector3.zero
local function stopFly()
    if bv then pcall(function() bv:Destroy() end); bv = nil end
    bvVel = Vector3.zero
end
local function startFly()
    local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    stopFly()
    bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(8e4, 8e4, 8e4)
    bv.Velocity = Vector3.zero
    bv.Parent = hrp
end

b(RunService.RenderStepped, function()
    if not S.fly then return end
    local c = LP.Character
    local hrp = c and c:FindFirstChild("HumanoidRootPart")
    local h = c and c:FindFirstChildOfClass("Humanoid")
    if not hrp or not h then return end
    if not bv or bv.Parent ~= hrp then startFly(); if not bv then return end end
    local cam = workspace.CurrentCamera
    local md = h.MoveDirection
    local flat = Vector3.new(md.X, 0, md.Z)
    local tgt = Vector3.zero
    if flat.Magnitude > 0.05 then
        tgt = flat.Unit * S.speed + Vector3.new(0, cam.CFrame.LookVector.Y * S.speed, 0)
    end
    bvVel = bvVel:Lerp(tgt, 0.14)
    bv.Velocity = bvVel
end)

