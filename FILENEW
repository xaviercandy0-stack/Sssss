--=========================================================
--  REMOTES
--=========================================================
local ALL, learned, replaying = {}, nil, false

local function collect()
    local out, seen = {}, {}
    for _, root in ipairs({ RS, workspace }) do
        pcall(function()
            for _, o in ipairs(root:GetDescendants()) do
                if (o:IsA("RemoteEvent") or o:IsA("RemoteFunction")) and not seen[o] then
                    seen[o] = true; table.insert(out, o)
                end
            end
        end)
    end
    ALL = out
    return #out
end

local function fire(remote, args)
    pcall(function()
        if remote:IsA("RemoteEvent") then
            remote:FireServer(unpackFn(args, 1, args.n or #args))
        elseif S.useFuncs then
            task.spawn(function() remote:InvokeServer(unpackFn(args, 1, args.n or #args)) end)
        end
    end)
end

local function getEnemies()
    local l, seen = {}, {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            local r = p.Character:FindFirstChild("HumanoidRootPart")
            if h and r and h.Health > 0 then
                seen[p.Character] = true
                table.insert(l, { char = p.Character, hum = h, root = r, player = p })
            end
        end
    end
    for _, m in ipairs(workspace:GetChildren()) do
        if m:IsA("Model") and not seen[m] and m ~= LP.Character and not Players:GetPlayerFromCharacter(m) then
            local h = m:FindFirstChildOfClass("Humanoid")
            local r = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
            if h and r and h.Health > 0 then
                table.insert(l, { char = m, hum = h, root = r })
            end
        end
    end
    return l
end

local function mapArgs(src, e)
    local out = packFn()
    for i = 1, (src.n or #src) do
        local v = src[i]
        local t = typeof(v)
        if t == "Instance" then
            if v:IsA("Player") then out[i] = e.player or v
            elseif v:IsA("Humanoid") then out[i] = e.hum
            elseif v:IsA("BasePart") then out[i] = e.root
            elseif v:IsA("Model") then out[i] = e.char
            else out[i] = v end
        elseif t == "Vector3" then out[i] = e.root.Position
        elseif t == "CFrame" then out[i] = CFrame.new(e.root.Position)
        else out[i] = v end
    end
    return out
end

local lastShot = 0
local SHOTK = { "shoot", "fire", "attack", "hit", "bullet", "damage", "dmg" }

local function scoreArgs(a)
    local s = 0
    for i = 1, (a.n or #a) do
        local t = typeof(a[i])
        if t == "Instance" then s += 3
        elseif t == "Vector3" or t == "CFrame" then s += 2
        elseif t == "number" then s += 1 end
    end
    return s
end

local function installHook()
    if not hookmetamethod or not getrawmetatable then return end
    pcall(function()
        local mt = getrawmetatable(game)
        local old = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = ncc(function(self, ...)
            if getnamecallmethod() == "FireServer" and not replaying
                and typeof(self) == "Instance" and self:IsA("RemoteEvent") then
                local n = self.Name:lower()
                for _, k in ipairs(SHOTK) do
                    if n:find(k, 1, true) then
                        local a = packFn(...)
                        local sc = scoreArgs(a)
                        if sc >= 2 and (not learned or sc > learned.score) then
                            learned = { remote = self, args = a, score = sc }
                            toast("Capturado: " .. self.Name)
                        end
                        break
                    end
                end
                if S.magic and learned and os.clock() - lastShot > (S.stealth and 0.3 or 0.12) then
                    lastShot = os.clock()
                    task.spawn(function()
                        for _, e in ipairs(getEnemies()) do
                            replaying = true
                            fire(learned.remote, mapArgs(learned.args, e))
                            replaying = false
                        end
                    end)
                end
            end
            return old(self, ...)
        end)
        setreadonly(mt, true)
    end)
end

