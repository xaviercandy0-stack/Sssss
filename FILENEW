local function getGun()
    local c = LP.Character
    if not c then return nil end
    for _, t in ipairs(c:GetChildren()) do
        if t:IsA("Tool") then return t end
    end
end

local function equip()
    local g = getGun(); if g then return g end
    local bp = LP:FindFirstChild("Backpack")
    local c = LP.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    if bp and h then
        for _, t in ipairs(bp:GetChildren()) do
            if t:IsA("Tool") then pcall(function() h:EquipTool(t) end); return t end
        end
    end
end

local function toolFire(e)
    local g = getGun() or equip()
    if not g then return end
    local cam = workspace.CurrentCamera
    cam.CFrame = CFrame.lookAt(cam.CFrame.Position, e.root.Position)
    pcall(function() g:Activate() end)
end

