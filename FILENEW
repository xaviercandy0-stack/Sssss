local function onChar(c)
    local h = c:WaitForChild("Humanoid", 20)
    if not h then return end
    invis = {}; bv = nil; bvVel = Vector3.zero; spawnedAt = os.clock()
    task.wait(0.4)
    h.WalkSpeed = S.walk
    h.UseJumpPower = true
    h.JumpPower = S.jump
    if S.fly then task.delay(0.6, startFly) end
    if S.invis then task.delay(0.6, function() setInvis(true) end) end
    b(h.Died, function() stopFly(); clearESP() end)
end
