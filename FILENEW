local invis = {}
local function setInvis(on)
    local c = LP.Character; if not c then return end
    for _, d in ipairs(c:GetDescendants()) do
        if d:IsA("BasePart") or d:IsA("Decal") then
            if on then
                if invis[d] == nil then invis[d] = d.Transparency end
                d.Transparency = 1
            elseif invis[d] ~= nil then
                d.Transparency = invis[d]; invis[d] = nil
            end
        end
    end
end

local hl = {}
local function clearESP()
    for _, h in pairs(hl) do pcall(function() h:Destroy() end) end
    hl = {}
end
local function refreshESP()
    if not S.esp then clearESP(); return end
    local alive = {}
    for _, e in ipairs(getEnemies()) do
        alive[e.char] = true
        if not hl[e.char] or not hl[e.char].Parent then
            local h = Instance.new("Highlight")
            h.FillColor = A2; h.FillTransparency = 0.6
            h.OutlineColor = A
            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            h.Adornee = e.char; h.Parent = e.char
            hl[e.char] = h
        end
    end
    for c, h in pairs(hl) do
        if not alive[c] then pcall(function() h:Destroy() end); hl[c] = nil end
    end
end

pcall(function()
    RunService:BindToRenderStep("NMODS_AIM", Enum.RenderPriority.Camera.Value + 1, function(dt)
        if not S.aim then return end
        local cam = workspace.CurrentCamera
        local best, bd = nil, math.huge
        local ctr = cam.ViewportSize / 2
        for _, e in ipairs(getEnemies()) do
            local sp, on = cam:WorldToViewportPoint(e.root.Position)
            if on then
                local d = (Vector2.new(sp.X, sp.Y) - ctr).Magnitude
                if d < bd then bd = d; best = e end
            end
        end
        if best then
            cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position, best.root.Position), math.clamp(dt * 10, 0, 1))
        end
    end)
end)

